[sqlfluff]
templater = raw
dialect = trino
max_line_length = 120
indent_unit = space
tab_space_size = 4

[sqlfluff:rules]
capitalisation_policy = upper
extended_capitalisation_policy = lower

[sqlfluff:rules:L010]
capitalisation_policy = upper

[sqlfluff:rules:L014]
extended_capitalisation_policy = lower
unquoted_identifiers_policy = all

[sqlfluff:rules:L019]
comma_style = trailing

[sqlfluff:rules:L036]
wildcard_policy = single
